# SENSITIVE FILES - NEVER COMMIT
# The SQLite database should never be committed as it may contain PII (Customer info), user data, and binary diffs bloat Git.
*.db
carrental.db
carrental.db-journal

# Compiled Outputs (Optional but highly recommended to exclude)
/build/

# Dependency tracking
/.classpath
